# Database Configuration (PostgreSQL)
# Option A: Standard individual credentials
DATABASE_USERNAME=fasturl_admin
DATABASE_PASSWORD=your_strong_password_here
DATABASE_NAME=fasturl_db
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
# Option B: Or single cloud connection string (e.g. Neon, Supabase, Render, Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis Cache Configuration
# Option A: Standard individual credentials
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
# Option B: Or single cloud connection string (e.g. Upstash, Railway)
# REDIS_URL=rediss://default:password@host:6379

# JWT Authentication
SECRET_KEY=your_generated_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment: development or production
ENVIRONMENT=development

